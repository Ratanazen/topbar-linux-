{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "height": 32,
  "margin-top": 4,
  "margin-left": 6,
  "margin-right": 6,
  "margin-bottom": 0,
  "spacing": 4,

  "modules-left": [
    "group/left1",
    "group/left2"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "group/tray-expander",
    "custom/darkmode",
    "bluetooth",
    "pulseaudio",
    "network",
    "memory",
    "cpu",
    "battery",
    "custom/power-profile",
    "custom/weather",
    "clock"
  ],

  /* Zone A: Left Group 1 (Settings / Status) */
  "group/left1": {
    "orientation": "inherit",
    "modules": [
      "custom/omarchy",
      "idle_inhibitor",
      "custom/update"
    ]
  },

  "custom/omarchy": {
    "format": "",
    "on-click": "fuzzel",
    "on-click-right": "nwg-drawer",
    "tooltip-format": "Applications Menu\n\nLeft-click: Fuzzel\nRight-click: Drawer"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    },
    "tooltip-format-activated": "Idle Inhibitor: Active (Screen stays on)",
    "tooltip-format-deactivated": "Idle Inhibitor: Inactive (Normal sleep)"
  },

  "custom/update": {
    "format": "󰏔 {}",
    "exec": "checkupdates 2>/dev/null | wc -l",
    "on-click": "kitty --title waybar_garuda-update -e garuda-update",
    "tooltip-format": "Garuda / Arch Updates Available\nClick to launch garuda-update",
    "interval": 3600
  },

  /* Zone A: Left Group 2 (Workspaces) */
  "group/left2": {
    "orientation": "inherit",
    "modules": [
      "sway/workspaces"
    ]
  },

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    },
    "on-click": "activate"
  },

  /* Zone B: Center Group (Active Window Title) */
  "sway/window": {
    "format": "{title}",
    "max-length": 55,
    "rewrite": {
      "(.*) — Mozilla Firefox": "󰈹 $1",
      "(.*) - Google Chrome": " $1",
      "(.*) - Visual Studio Code": "󰨞 $1",
      "(.*) - kitty": "󰄛 $1",
      "(.*) - Foot": "󰄛 $1",
      "(.*) - Spotify": " $1",
      "(.*)cbonsai(.*)": "👻 cbonsai --screensave ~",
      "^$": " Desktop"
    }
  },

  /* Zone C: Right Group (Status & Information) */
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },

  "custom/expand-icon": {
    "format": "  ",
    "tooltip": false
  },

  "tray": {
    "icon-size": 13,
    "spacing": 10
  },

  "custom/darkmode": {
    "format": "{}",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "exec": "$HOME/.config/waybar/scripts/toggle_dark_light.sh",
    "on-click": "$HOME/.config/waybar/scripts/toggle_dark_light.sh --toggle",
    "tooltip": true
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "",
    "tooltip-format": "Bluetooth Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Volume: {volume}%",
    "scroll-step": 5
  },

  "network": {
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰖪",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "Ethernet: ⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "nm-connection-editor"
  },

  "memory": {
    "interval": 2,
    "format": " {percentage:02}%",
    "on-click": "kitty -e htop"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage:02}%",
    "on-click": "kitty -e htop"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% {icon}",
    "format-plugged": " {capacity}%",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "interval": 5,
    "on-click": "/home/reny/.config/sway/scripts/power_menu.sh",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "custom/power-profile": {
    "format": "{}",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "exec": "$HOME/.config/waybar/scripts/power-profile.sh",
    "on-click": "$HOME/.config/waybar/scripts/power-profile.sh --next",
    "tooltip": true
  },

  "custom/weather": {
    "format": "{}",
    "return-type": "json",
    "interval": 1800,
    "exec": "$HOME/.config/waybar/scripts/weather.sh",
    "tooltip": true
  },

  "clock": {
    "format": " {:%H:%M %a}",
    "format-alt": " {:%H:%M %Y-%m-%d}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  }
}
